# Aura AI Chatbot - Environment Configuration
# Copy this file to .env and fill in your actual values

# MongoDB connection string
# Example: mongodb://localhost:27017/aura or your MongoDB Atlas connection
MONGO_URI=

# JWT secret for token signing (use a strong random string)
# Example: your-super-secret-jwt-key-change-this-in-production
JWT_SECRET=

# OpenRouter API key for accessing OpenRouter models
# Get from: https://openrouter.ai
OPENROUTER_API_KEY=

# Google Generative AI (Gemini) API key
# Get from: https://ai.google.dev
GEMINI_API_KEY=

# Tavily API key for web search functionality (Optional)
# Get from: https://tavily.com
# Remove this line if web search is not needed
TAVILY_API_KEY=

# Email service configuration used by the existing Brevo mail utility
BREVO_API_KEY=
# Must be a sender address verified in Brevo; defaults to the existing sender if unset.
BREVO_SENDER_EMAIL=
# Legacy email variables retained for deployments that still use them elsewhere
EMAIL_USER=
EMAIL_PASS=
TRUST_PROXY=true

# Public origin where the app's HTML pages are served; set this to the deployed Aura URL in production.
FRONTEND_URL=http://localhost:5000


# Optional: Node environment (development/production)
# NODE_ENV=development

# Static asset cache-busting version.
# Bump this on each Render deployment that changes public CSS or JS.
ASSET_VERSION=1.0.0

# Optional: Server port (defaults to 5000)
# PORT=5000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SIGNUP_PRICE_PAISE=200
REQUIRE_PAYMENT_FOR_SIGNUP=true

# Optional production hardening
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# TRUST_PROXY=true
# LOG_LEVEL=info
# AI_TIMEOUT_MS=60000
# SEARCH_TIMEOUT_MS=12000
